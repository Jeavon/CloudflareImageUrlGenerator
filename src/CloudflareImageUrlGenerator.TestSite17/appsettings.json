{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "84782227-6e65-4a6f-be83-4eb6fde0d016"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true,
        "InstallUnattended": true,
        "UnattendedUserEmail": "demo@umbraco.com",
        "UnattendedUserName": "Demo",
        "UnattendedUserPassword": "1234567890"
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {
       "HMACSecretKey": "sAK5JNdYpykLEa4JGgZm5Xrt65gZrYeMR1RHJm0X5CdtdH\u002BQgveA0TOZykuRY/ufCy5xtwWAlOlCdNWdM\u002BoVvw=="
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "CloudflareImageUrlGenerator": {
    "Enabled": true,
    "CloudFlareSupportedImageFileTypes": [ "webp", "avif", "jpg", "png" ]
  }
}
