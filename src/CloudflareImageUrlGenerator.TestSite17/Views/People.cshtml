        <h2>Without Slimsy - Using a predefined crop with sourceWidth and sourceHeight (crop offloaded to Cloudflare via trim)</h2>
        <div class="employee-grid">
            @foreach (Person person in Model.Children<Person>())
            {
                if (person.Photo != null)
                {
                    <div class="employee-grid__item">
                        <div class="employee-grid__item__image">
                            @{
                                // sourceWidth and sourceHeight allow the fractional crop coordinates (rxy)
                                // to be converted into pixel values for Cloudflare's trim parameter.
                                // Without them, ImageSharp would handle the crop instead.
                                var sourceWidth = person.Photo.Value<int>("umbracoWidth");
                                var sourceHeight = person.Photo.Value<int>("umbracoHeight");
                                var imageUrl = Url.GetCropUrl(person.Photo, cropAlias: "GlobalSquare", useCropDimensions: true, furtherOptions: $"sourceWidth={sourceWidth}&sourceHeight={sourceHeight}&format=webp", htmlEncode: false).ToString();
                            }
                            <div class="employee-grid__item__image"><img src="@imageUrl" alt="@person.Name" /></div>
                        </div>
                        @{
                            ContactDetails(person);
                        }
                    </div>
                }
            }
        </div>
        <h2>Without Slimsy - Fallback (no sourceWidth/sourceHeight, crop handled by ImageSharp)</h2>
        <div class="employee-grid">
            @foreach (Person person in Model.Children<Person>())
            {
                if (person.Photo != null)
                {
                    <div class="employee-grid__item">
                        <div class="employee-grid__item__image">
                            @{
                                // Without sourceWidth and sourceHeight, the fractional crop coordinates (rxy)
                                // cannot be converted to Cloudflare trim pixel values.
                                // The rxy parameter stays in the ImageSharp source URL and ImageSharp
                                // handles the crop. Cloudflare still handles format conversion and quality.
                                var imageUrl = Url.GetCropUrl(person.Photo, cropAlias: "GlobalSquare", useCropDimensions: true, furtherOptions: "format=webp", htmlEncode: false).ToString();
                            }
                            <div class="employee-grid__item__image"><img src="@imageUrl" alt="@person.Name" /></div>
                        </div>
                        @{
                            ContactDetails(person);
                        }
                    </div>
                }
            }
        </div>
