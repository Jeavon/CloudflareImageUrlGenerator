<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>App_Plugins/CloudflareImageUrlGenerator</StaticWebAssetBasePath>
    <NoWarn>$(NoWarn);NU5118;NU1902;NU1903</NoWarn>
    <!-- Symbol file configuration -->
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Enable deterministic builds in CI -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- SourceLink configuration -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Umbraco.Community.CloudflareImageUrlGenerator</PackageId>
    <Product>CloudflareImageUrlGenerator</Product>
    <Title>CloudflareImageUrlGenerator</Title>
    <Description>Image Url generator for Umbraco to use Cloudflare Image Resizing</Description>
    <PackageTags>umbraco plugin package images responsive umbraco-marketplace</PackageTags>
    <Authors>Jeavon Leopold</Authors>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageIcon>cloudflareimageurlgenerator.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Jeavon/CloudflareImageUrlGenerator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Jeavon/CloudflareImageUrlGenerator</RepositoryUrl>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.103" PrivateAssets="All" />
    <PackageReference Include="Umbraco.Cms.Imaging.ImageSharp" Version="17.3.0" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="17.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../readme.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="../../cloudflareimageurlgenerator.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <!-- Remove schema from default content items so we can explicitly control packaging -->
    <Content Remove="appsettings-schema.CloudflareImageUrlGenerator.json" />
    <Content Include="buildTransitive\**" PackagePath="buildTransitive" />
    <Content Include="appsettings-schema.CloudflareImageUrlGenerator.json" PackagePath="" />
  </ItemGroup>
</Project>
